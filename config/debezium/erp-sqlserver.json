{
  "connector.class": "io.debezium.connector.sqlserver.SqlServerConnector",
  "tasks.max": "1",

  "database.hostname": "${env:SQLSERVER_HOST}",
  "database.port": "${env:SQLSERVER_PORT}",
  "database.user": "${env:SQLSERVER_CDC_USER}",
  "database.password": "${env:SQLSERVER_CDC_PASSWORD}",
  "database.names": "${env:SQLSERVER_DB}",
  "database.encrypt": "true",
  "database.trustServerCertificate": "true",

  "topic.prefix": "erp",
  "table.include.list": "dbo.Orders,dbo.OrderItems,dbo.Stock,dbo.Payments,dbo.Shipments",

  "signal.data.collection": "${env:SQLSERVER_DB}.dbo.DebeziumSignal",
  "incremental.snapshot.chunk.size": "5000",

  "snapshot.mode": "initial",
  "snapshot.isolation.mode": "read_committed",
  "time.precision.mode": "connect",
  "decimal.handling.mode": "precise",
  "tombstones.on.delete": "false",
  "schema.name.adjustment.mode": "avro",

  "schema.history.internal.kafka.bootstrap.servers": "kafka:9092",
  "schema.history.internal.kafka.topic": "_schema-history.erp",

  "topic.creation.default.replication.factor": "1",
  "topic.creation.default.partitions": "3",
  "topic.creation.default.compression.type": "zstd",

  "key.converter": "io.confluent.connect.avro.AvroConverter",
  "key.converter.schema.registry.url": "http://karapace:8081",
  "value.converter": "io.confluent.connect.avro.AvroConverter",
  "value.converter.schema.registry.url": "http://karapace:8081"
}
