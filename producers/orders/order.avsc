{
  "type": "record",
  "name": "Order",
  "namespace": "datalake.poc",
  "doc": "Order event from a fictitious store, generated for testing.",
  "fields": [
    { "name": "order_id",    "type": "string", "doc": "Order UUID" },
    { "name": "customer_id", "type": "int" },
    { "name": "product",     "type": "string" },
    { "name": "quantity",    "type": "int" },
    { "name": "unit_price",  "type": { "type": "bytes", "logicalType": "decimal", "precision": 12, "scale": 2 } },
    { "name": "status", "type": { "type": "enum", "name": "OrderStatus",
        "symbols": ["CREATED", "PAID", "SHIPPED", "DELIVERED", "CANCELLED"] } },
    { "name": "channel", "type": ["null", "string"], "default": null, "doc": "store, app, web; may be missing" },
    { "name": "created_at", "type": { "type": "long", "logicalType": "timestamp-millis" } }
  ]
}
