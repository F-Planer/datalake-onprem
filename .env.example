# Secrets template. Copy to .env (chmod 600) and replace every placeholder,
# e.g. with: openssl rand -base64 24. Never commit .env.
POSTGRES_PASSWORD=change-this-password
POLARIS_DB_PASSWORD=change-this-password
AIRFLOW_DB_PASSWORD=change-this-password

# SeaweedFS S3 credential (used by Polaris, Spark and Trino)
S3_ACCESS_KEY=lakehouse
S3_SECRET_KEY=change-this-password

# Polaris root principal credential
POLARIS_ROOT_CLIENT_ID=root
POLARIS_ROOT_CLIENT_SECRET=change-this-password

# SQL Server source. For the real database, change host, database, users and passwords.
SQLSERVER_HOST=sqlserver
SQLSERVER_PORT=1433
SQLSERVER_DB=SimulatedErp
# Read-only logins: CDC (Debezium) and scheduled loads (Airflow)
SQLSERVER_CDC_USER=datalake_cdc
SQLSERVER_CDC_PASSWORD=change-this-password
SQLSERVER_BATCH_USER=datalake_batch
SQLSERVER_BATCH_PASSWORD=change-this-password
# Simulated SQL Server only (simulated-source profile)
MSSQL_SA_PASSWORD=change-this-password

# DW database on SQL Server (receives the gold layer) and the lake's write login, limited to that database
SQLSERVER_DW_DB=AnalyticsDW
SQLSERVER_DW_USER=datalake_dw
SQLSERVER_DW_PASSWORD=change-this-password

# Airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-this-password
AIRFLOW_FERNET_KEY=generate with: python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_JWT_SECRET=change-this-password

# JupyterLab (notebook profile): access token
JUPYTER_TOKEN=change-this-token
